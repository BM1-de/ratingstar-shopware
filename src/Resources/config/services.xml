<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="RatingStar\Seal\Service\RatingStarConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="RatingStar\Seal\Service\RatingStarClient">
            <argument type="service" id="http_client"/>
            <argument type="service" id="cache.object"/>
            <argument type="service" id="RatingStar\Seal\Service\RatingStarConfig"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="RatingStar\Seal\Subscriber\ConfigChangeSubscriber">
            <argument type="service" id="RatingStar\Seal\Service\RatingStarClient"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="RatingStar\Seal\Command\ClearCacheCommand">
            <argument type="service" id="RatingStar\Seal\Service\RatingStarClient"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>

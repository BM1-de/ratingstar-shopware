{% block sw_cms_el_config_rs_seal %}
<div class="sw-cms-el-config-rs-seal">

    {% block sw_cms_el_config_rs_seal_variant %}
    <mt-select
        class="sw-cms-el-config-rs-seal__variant"
        :label="$t('rs-seal.element.config.variant.label')"
        :help-text="$t('rs-seal.element.config.variant.helpText')"
        :options="variantChoices"
        :model-value="variant"
        hide-clearable-button
        @update:model-value="element.config.variant.value = $event || variant"
    />

    <mt-select
        v-if="canBeStatic"
        class="sw-cms-el-config-rs-seal__render-mode"
        :label="$t('rs-seal.element.config.renderMode.label')"
        :help-text="$t('rs-seal.element.config.renderMode.helpText')"
        :options="renderModeChoices"
        :model-value="isStatic ? 'static' : 'live'"
        hide-clearable-button
        @update:model-value="element.config.renderMode.value = $event || 'live'"
    />

    <mt-select
        v-if="showPosition"
        class="sw-cms-el-config-rs-seal__position"
        :label="$t('rs-seal.element.config.position.label')"
        :help-text="$t('rs-seal.element.config.position.helpText')"
        :options="positionChoices"
        :model-value="element.config.position.value ?? ''"
        hide-clearable-button
        @update:model-value="onSelect('position', $event)"
    />
    {% endblock %}

    {% block sw_cms_el_config_rs_seal_subject %}
    <h4 class="sw-cms-el-config-rs-seal__heading">
        {{ $t('rs-seal.element.config.subject.heading') }}
    </h4>

    <mt-text-field
        v-model="element.config.slug.value"
        class="sw-cms-el-config-rs-seal__slug"
        :label="$t('rs-seal.element.config.slug.label')"
        :help-text="$t('rs-seal.element.config.slug.helpText')"
        :placeholder="$t('rs-seal.element.config.fromPluginConfig')"
    />

    <mt-text-field
        v-model="element.config.group.value"
        class="sw-cms-el-config-rs-seal__group"
        :label="$t('rs-seal.element.config.group.label')"
        :help-text="$t('rs-seal.element.config.group.helpText')"
        :placeholder="$t('rs-seal.element.config.fromPluginConfig')"
    />
    {% endblock %}

    {% block sw_cms_el_config_rs_seal_options %}
    <template v-if="optionKeys.length > 0">
        <h4 class="sw-cms-el-config-rs-seal__heading">
            {{ $t('rs-seal.element.config.options.heading') }}
        </h4>

        <template
            v-for="key in optionKeys"
            :key="key"
        >
            <mt-text-field
                v-if="optionType(key) === 'int'"
                v-model="element.config[key].value"
                :class="`sw-cms-el-config-rs-seal__option-${key}`"
                :label="optionLabel(key)"
                :help-text="optionHelpText(key)"
                :placeholder="$t('rs-seal.element.config.default')"
            />

            <mt-colorpicker
                v-else-if="optionType(key) === 'color'"
                v-model="element.config[key].value"
                :class="`sw-cms-el-config-rs-seal__option-${key}`"
                :label="optionLabel(key)"
                :help-text="optionHelpText(key)"
                :placeholder="$t('rs-seal.element.config.default')"
                color-output="hex"
                :alpha="false"
                :z-index="1001"
            />

            <mt-select
                v-else
                :class="`sw-cms-el-config-rs-seal__option-${key}`"
                :label="optionLabel(key)"
                :help-text="optionHelpText(key)"
                :options="optionChoices(key)"
                :model-value="element.config[key].value ?? ''"
                hide-clearable-button
                @update:model-value="onSelect(key, $event)"
            />
        </template>
    </template>
    {% endblock %}

    {% block sw_cms_el_config_rs_seal_static %}
    <mt-text-field
        v-if="isStatic"
        v-model="element.config.award.value"
        class="sw-cms-el-config-rs-seal__award"
        :label="$t('rs-seal.element.config.award.label')"
        :help-text="$t('rs-seal.element.config.award.helpText')"
    />
    {% endblock %}

    {% block sw_cms_el_config_rs_seal_expert %}
    <template v-if="!isStatic">
        <h4 class="sw-cms-el-config-rs-seal__heading">
            {{ $t('rs-seal.element.config.expert.heading') }}
        </h4>

        <mt-textarea
            v-model="element.config.dataAttributes.value"
            class="sw-cms-el-config-rs-seal__data-attributes"
            :label="$t('rs-seal.element.config.dataAttributes.label')"
            :help-text="$t('rs-seal.element.config.dataAttributes.helpText')"
            placeholder="data-size=&quot;240&quot; data-theme=&quot;dark&quot;"
        />
    </template>
    {% endblock %}

    {% block sw_cms_el_config_rs_seal_google %}
    <h4 class="sw-cms-el-config-rs-seal__heading">
        {{ $t('rs-seal.element.config.google.heading') }}
    </h4>

    <mt-text-field
        v-model="element.config.apiKey.value"
        class="sw-cms-el-config-rs-seal__api-key"
        :label="$t('rs-seal.element.config.apiKey.label')"
        :help-text="$t('rs-seal.element.config.apiKey.helpText')"
        :placeholder="$t('rs-seal.element.config.fromPluginConfig')"
    />

    <mt-select
        v-if="!isStatic"
        class="sw-cms-el-config-rs-seal__no-rich-snippet"
        :label="$t('rs-seal.element.config.noRichSnippet.label')"
        :help-text="$t('rs-seal.element.config.noRichSnippet.helpText')"
        :options="noRichSnippetChoices"
        :model-value="element.config.noRichSnippet.value ?? ''"
        hide-clearable-button
        @update:model-value="onSelect('noRichSnippet', $event)"
    />
    {% endblock %}
</div>
{% endblock %}
